{
  "name": "@bingvader/fluid-scale",
  "version": "0.1.1",
  "description": "Zero-dependency fluid clamp math with optional PostCSS, React and Native adapters",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BingVader/fluid-scale.git"
  },
  "bugs": {
    "url": "https://github.com/BingVader/fluid-scale/issues"
  },
  "homepage": "https://github.com/BingVader/fluid-scale#readme",
  "keywords": [
    "fluid",
    "clamp",
    "responsive",
    "typography",
    "scaling",
    "postcss",
    "react",
    "react-native"
  ],
  "type": "module",
  "author": "BingVader",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./postcss": {
      "types": "./dist/postcss/index.d.mts",
      "import": "./dist/postcss/index.mjs",
      "require": "./dist/postcss/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.mts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.cjs"
    },
    "./native": {
      "types": "./dist/native/index.d.mts",
      "import": "./dist/native/index.mjs",
      "require": "./dist/native/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "postcss": "^8.0.0",
    "react": ">=16.8.0 || ^18.0.0 || ^19.0.0",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^17.0.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.23.7",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
